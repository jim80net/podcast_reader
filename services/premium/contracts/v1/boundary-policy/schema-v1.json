{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jim80net/podcast_reader/blob/main/services/premium/contracts/v1/boundary-policy/schema-v1.json",
  "title": "Podcast Reader cross-product boundary policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract", "policy_revision", "data_classes", "zones", "operations", "copy_claims", "surface_enforcement", "exceptions"],
  "properties": {
    "schema_version": {"const": 1},
    "contract": {"const": "podcast-reader-boundary-policy"},
    "policy_revision": {"type": "integer", "minimum": 1},
    "data_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/data_class"}},
    "zones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "copy_claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/copy_claim"}},
    "surface_enforcement": {"$ref": "#/$defs/surface_enforcement"},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "issue": {"type": "string", "pattern": "^https://github\\.com/jim80net/podcast_reader/issues/[1-9][0-9]*$"},
    "id_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "data_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sensitivity", "description"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sensitivity": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}}
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "retention", "description"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "retention": {"$ref": "#/$defs/id"}, "description": {"type": "string", "minLength": 1}}
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "surface", "from_zone", "to_zone", "transport", "method", "route", "request_contract", "response_contract", "request_data", "response_data", "destination_persistence", "logging", "guards", "admitting_issue", "enforcement_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "surface": {"enum": ["android", "backend", "desktop", "extension", "private-web"]},
        "from_zone": {"$ref": "#/$defs/id"}, "to_zone": {"$ref": "#/$defs/id"}, "transport": {"$ref": "#/$defs/id"},
        "method": {"type": "string", "minLength": 1, "not": {"pattern": "\\*"}}, "route": {"type": "string", "pattern": "^/", "not": {"pattern": "\\*"}},
        "request_contract": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "response_contract": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "request_data": {"$ref": "#/$defs/id_array"}, "response_data": {"$ref": "#/$defs/id_array"}, "destination_persistence": {"$ref": "#/$defs/id_array"}, "logging": {"$ref": "#/$defs/id_array"}, "guards": {"$ref": "#/$defs/id_array"},
        "admitting_issue": {"$ref": "#/$defs/issue"}, "enforcement_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "copy_claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation_ids", "surfaces", "canonical_facts", "admitting_issue"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "operation_ids": {"$ref": "#/$defs/id_array"}, "surfaces": {"$ref": "#/$defs/id_array"}, "canonical_facts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "admitting_issue": {"$ref": "#/$defs/issue"}}
    },
    "declared_root": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "surface", "kind", "network_capable", "admitting_issue"],
      "properties": {"path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "surface": {"enum": ["android", "backend", "desktop", "extension", "private-web"]}, "kind": {"$ref": "#/$defs/id"}, "network_capable": {"type": "boolean"}, "admitting_issue": {"$ref": "#/$defs/issue"}}
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["projection", "checker_ids", "consuming_tests"],
      "properties": {"projection": {"type": "string", "pattern": "^projection-[a-z-]+-v1\\.json$"}, "checker_ids": {"$ref": "#/$defs/id_array"}, "consuming_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "legacy_fence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "assertion", "operation_ids", "replacement_checker", "retained_as_defense_in_depth", "admitting_issue"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "path": {"type": "string", "minLength": 1}, "assertion": {"type": "string", "minLength": 1}, "operation_ids": {"$ref": "#/$defs/id_array"}, "replacement_checker": {"$ref": "#/$defs/id"}, "retained_as_defense_in_depth": {"const": true}, "admitting_issue": {"$ref": "#/$defs/issue"}}
    },
    "surface_enforcement": {
      "type": "object", "additionalProperties": false,
      "required": ["declared_roots", "surfaces", "legacy_fences"],
      "properties": {
        "declared_roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/declared_root"}},
        "surfaces": {"type": "object", "additionalProperties": false, "required": ["android", "backend", "desktop", "extension", "private-web"], "properties": {"android": {"$ref": "#/$defs/surface"}, "backend": {"$ref": "#/$defs/surface"}, "desktop": {"$ref": "#/$defs/surface"}, "extension": {"$ref": "#/$defs/surface"}, "private-web": {"$ref": "#/$defs/surface"}}},
        "legacy_fences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/legacy_fence"}}
      }
    },
    "exception": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "operation_id", "reason", "owner", "expires_on", "removal_condition", "admitting_issue"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "reason": {"type": "string", "minLength": 1}, "owner": {"$ref": "#/$defs/id"}, "expires_on": {"type": "string", "format": "date"}, "removal_condition": {"type": "string", "minLength": 1}, "admitting_issue": {"$ref": "#/$defs/issue"}}
    }
  }
}
