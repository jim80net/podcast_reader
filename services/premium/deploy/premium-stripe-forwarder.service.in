[Unit]
Description=Podcast Reader premium Stripe sandbox webhook forwarder
After=network-online.target premium-dev.service
Wants=network-online.target
Requires=premium-dev.service
ConditionPathExists=@STRIPE_ENV@

[Service]
Type=simple
EnvironmentFile=@STRIPE_ENV@
ExecStart=@STRIPE@ listen --skip-update --events checkout.session.completed,checkout.session.expired --forward-to http://127.0.0.1:@LOOPBACK_PORT@/v1/webhooks/stripe
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATE_DIR@
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes

[Install]
WantedBy=default.target
